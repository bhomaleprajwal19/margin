# Copy to .env and adjust. Everything here has a sensible default for local dev.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database. Leave unset for SQLite. Examples:
# DATABASE_URL=mysql://margin:margin@127.0.0.1:3306/margin
# DATABASE_URL=postgres://margin:margin@127.0.0.1:5432/margin

# Only needed if the frontend is served from a different origin than the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173
